<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_xacro">

  <xacro:property name="prefix" default="explorer"/>


  <link name="${prefix}/base_link"/>
  <link name="${prefix}/imu_link"/>
  <link name="${prefix}/camera_link"/>
  <!-- <link name="${prefix}/xsens"/> -->

  <joint name="${prefix}base_to_imu_joint" type="fixed">
    <parent link="${prefix}/base_link"/>
    <child link="${prefix}/imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="${prefix}base_to_camera_joint" type="fixed">
    <parent link="${prefix}/base_link"/>
    <child link="${prefix}/camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- <joint name="${prefix}imu_to_xsens_joint" type="fixed">
    <parent link="${prefix}/imu_link"/>
    <child link="${prefix}/xsens"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->

</robot>